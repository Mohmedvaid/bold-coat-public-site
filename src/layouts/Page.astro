---
import Base from './Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
  ogImage?: string;
}

const props = Astro.props;
---

<Base {...props}>
  <Navbar slot="header" />
  <slot />
  <Footer slot="footer" />
</Base>
