---
import { site, isPending } from '../config/site';

const showRating =
  !isPending(site.aggregateReviews.rating) && !isPending(site.aggregateReviews.count);
---

<ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-ink/80">
  {
    showRating && (
      <li class="inline-flex items-center gap-2">
        <span class="inline-flex text-gold" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => (
            <svg class="size-4" viewBox="0 0 20 20" fill="currentColor">
              <path d="M10 1.6l2.3 4.7 5.2.8-3.8 3.6.9 5.2L10 13.4 5.4 15.9l.9-5.2L2.5 7.1l5.2-.8L10 1.6z" />
            </svg>
          ))}
        </span>
        <span>
          {site.aggregateReviews.rating} from {site.aggregateReviews.count} reviews
        </span>
      </li>
    )
  }
  <li>Licensed &amp; Insured</li>
  <li>Serving the North Shore</li>
</ul>
