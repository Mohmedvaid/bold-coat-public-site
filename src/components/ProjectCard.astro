---
import MediaPlaceholder from './MediaPlaceholder.astro';

interface Props {
  town: string;
  service: string;
  title: string;
  scope: string;
  href: string;
}

const { town, service, title, scope, href } = Astro.props;
---

<article class="reveal">
  <a href={href} class="group block">
    <MediaPlaceholder
      aspect="aspect-[16/9]"
      label={`${service} project photo placeholder, ${town}`}
      class="transition-transform duration-200 group-hover:-translate-y-0.5"
    />
    <p class="mt-4 text-label font-medium uppercase tracking-[0.08em] text-navy">
      {town} · {service}
    </p>
    <h3 class="mt-2 text-2xl md:text-3xl">{title}</h3>
    <p class="mt-2 max-w-2xl text-base text-ink/75">{scope}</p>
  </a>
</article>
