---
import MediaPlaceholder from './MediaPlaceholder.astro';

interface Props {
  title: string;
  href: string;
  description: string;
  delay?: number;
}

const { title, href, description, delay = 0 } = Astro.props;
---

<article
  class="reveal group bg-paper shadow-sm transition-transform duration-200 hover:-translate-y-0.5 hover:shadow-md"
  style={`animation-delay: ${delay}ms`}
>
  <MediaPlaceholder aspect="aspect-[4/3]" label={`${title} project photo placeholder`} />
  <div class="p-5">
    <h3 class="text-2xl">{title}</h3>
    <p class="mt-2 text-base text-ink/75">{description}</p>
    <a href={href} class="mt-4 inline-flex items-center gap-1 text-base font-medium text-red">
      Learn more
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
