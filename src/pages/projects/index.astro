---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CTABand from '../../components/CTABand.astro';
import { site } from '../../config/site';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const title = 'Painting Projects | Bold Coat Painters';
const description =
  'North Shore painting projects across Winnetka, Wilmette, Glenview, and Lake Forest. Browse case studies and request a free on-site estimate.';
---

<Page title={title} description={description} canonicalPath="/projects">
  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
      <p class="text-label font-medium uppercase tracking-[0.08em] text-navy">Projects</p>
      <h1 class="mt-3 max-w-3xl text-[1.75rem] sm:text-4xl md:text-5xl">
        Real North Shore painting projects
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-ink/80">
        Case studies without street addresses or full customer names. Cream blocks stand in until
        project photos arrive. Call{' '}
        <a class="text-red" href={`tel:${site.phone}`}>{site.phoneDisplay}</a> to talk through a
        similar scope.
      </p>

      <div class="mt-12 grid gap-10 md:grid-cols-2">
        {
          projects.map((project) => {
            const city = site.cities.find((item) => item.slug === project.data.city);
            const serviceLabel =
              site.services.find((item) => item.href.endsWith(project.data.services[0] ?? ''))
                ?.name ?? 'Painting';
            return (
              <ProjectCard
                town={city?.name ?? project.data.city}
                service={serviceLabel.replace(' Painting', '').replace('Fence & Deck Staining', 'Deck')}
                title={project.data.title}
                scope={project.data.scopeSummary}
                href={`/projects/${project.id}`}
              />
            );
          })
        }
      </div>
    </div>
  </section>

  <CTABand heading="Want this level of finish on your home?" />
</Page>
