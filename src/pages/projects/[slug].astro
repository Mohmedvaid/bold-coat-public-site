---
import { getCollection, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import MediaPlaceholder from '../../components/MediaPlaceholder.astro';
import BeforeAfterSlider from '../../components/islands/BeforeAfterSlider';
import CTABand from '../../components/CTABand.astro';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const city = site.cities.find((item) => item.slug === data.city);
const serviceLinks = data.services
  .map((slug) => site.services.find((service) => service.href === `/services/${slug}`))
  .filter((service): service is (typeof site.services)[number] => Boolean(service));

const metaTitle = data.metaTitle;
const description = data.description;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: site.url,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Projects',
      item: new URL('/projects', site.url).href,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: data.title,
      item: new URL(`/projects/${entry.id}`, site.url).href,
    },
  ],
};

const gallerySchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: data.title,
  description: data.scopeSummary,
  url: new URL(`/projects/${entry.id}`, site.url).href,
};
---

<Page title={metaTitle} description={description} canonicalPath={`/projects/${entry.id}`}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(gallerySchema)} />

  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
      <nav class="text-sm text-stone" aria-label="Breadcrumb">
        <ol class="flex flex-wrap gap-2">
          <li><a class="text-red hover:underline" href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a class="text-red hover:underline" href="/projects">Projects</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ink">{data.title}</li>
        </ol>
      </nav>

      <p class="mt-6 text-label font-medium uppercase tracking-[0.08em] text-navy">
        {city?.name ?? data.city}
        {' · '}
        {serviceLinks.map((service) => service.name).join(', ')}
      </p>
      <h1 class="mt-3 max-w-3xl text-[1.75rem] sm:text-4xl md:text-5xl">{data.title}</h1>
      <p class="mt-5 max-w-2xl text-lg text-ink/80">{data.scopeSummary}</p>

      <div class="mt-8">
        <MediaPlaceholder aspect="aspect-[16/9]" label={data.coverAlt} />
      </div>

      <dl class="mt-8 grid gap-6 sm:grid-cols-3">
        <div>
          <dt class="text-sm text-stone">Duration</dt>
          <dd class="mt-1 font-display text-2xl text-ink">{data.durationDays} days</dd>
        </div>
        <div>
          <dt class="text-sm text-stone">Surfaces</dt>
          <dd class="mt-1 text-base text-ink">{data.surfaces}</dd>
        </div>
        <div>
          <dt class="text-sm text-stone">Colors</dt>
          <dd class="mt-1 text-base text-ink">
            {
              data.colorsUsed.map((color) => (
                <span class="block">
                  {color.brand}: {color.name}
                </span>
              ))
            }
          </dd>
        </div>
      </dl>
    </div>
  </section>

  {
    data.hasBeforeAfter && (
      <section class="bg-cream" aria-labelledby="project-slider-heading">
        <div class="mx-auto max-w-6xl px-4 py-16 md:px-6">
          <h2 id="project-slider-heading" class="text-[2rem] md:text-4xl">
            Before and after
          </h2>
          <div class="mt-8">
            <BeforeAfterSlider
              client:visible
              beforeLabel={`Before photo for ${data.title}, coming soon`}
              afterLabel={`After photo for ${data.title}, coming soon`}
            />
          </div>
        </div>
      </section>
    )
  }

  <section class="bg-paper" aria-labelledby="project-gallery-heading">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20">
      <h2 id="project-gallery-heading" class="text-[2rem] md:text-4xl">Project gallery</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          data.galleryAlts.map((alt) => (
            <MediaPlaceholder aspect="aspect-[4/3]" label={alt} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-cream" aria-labelledby="project-story-heading">
    <div class="mx-auto max-w-3xl px-4 py-16 md:px-6 md:py-20">
      <h2 id="project-story-heading" class="text-[2rem] md:text-4xl">Project story</h2>
      <div class="prose-project mt-8 text-base leading-relaxed text-ink/85">
        <Content />
      </div>
      <div class="mt-10 flex flex-wrap gap-4 text-base">
        {
          city && (
            <a class="text-red hover:underline" href={`/${city.slug}`}>
              House painters in {city.name}
            </a>
          )
        }
        {
          serviceLinks.map((service) => (
            <a class="text-red hover:underline" href={service.href}>
              {service.name}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTABand heading="Planning a similar project?" />
</Page>

<style>
  .prose-project :global(p + p) {
    margin-top: 1.25rem;
  }
</style>
