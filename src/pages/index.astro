---
import Page from '../layouts/Page.astro';
---

<Page
  title="House Painters in Chicago's North Shore | Bold Coat"
  description="Premium exterior and interior painting for Winnetka, Wilmette, and the North Shore. Request a free on-site estimate from Bold Coat Painters."
  canonicalPath="/"
>
  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-4 py-20 md:px-6 md:py-28">
      <p class="mb-3 text-label font-medium uppercase tracking-[0.08em] text-navy">
        Phase 0 shell
      </p>
      <h1 class="max-w-3xl text-[1.75rem] sm:text-4xl md:text-5xl">
        Exterior and interior painting, done right.
      </h1>
      <p class="mt-5 max-w-xl text-lg text-ink/80">
        Foundations are in place: design tokens, layouts, navbar, and footer. Homepage sections
        land in Phase 1.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="/contact"
          class="inline-flex bg-red px-5 py-3 text-base font-medium text-paper transition-colors hover:bg-[#c73828]"
        >
          Free Estimate
        </a>
        <a href="/projects" class="text-base font-medium text-red hover:underline">
          See our work
        </a>
      </div>
      <div class="mt-12 aspect-[16/9] w-full max-w-3xl bg-cream" aria-hidden="true"></div>
    </div>
  </section>
</Page>
